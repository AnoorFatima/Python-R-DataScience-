import pandas as pd
import seaborn as sns
import matplotlib.pyplot as plt
import numpy as np
import os
np.random.seed(42)
n=200
data={
    "date": pd.date_range(start="2024-01-01", periods=200),
    "categories": np.random.choice(['A','B','C','D'],size=200),
    "category_column": np.random.choice(['A','B','C','D'],size=200),
    "column_1": np.random.normal(loc=60,scale=10,size=200),
    "column_2": np.random.normal(loc=50,scale=15,size=200),
    "column_3": np.random.normal(loc=100,scale=20,size=200)
}
df=pd.DataFrame(data)
print(df)
corr_mat=df.corr(numeric_only=True)
print(corr_mat)
sns.heatmap(
    corr_mat,
    annot=True,
    cmap="coolwarm",
    vmin=-1,
    vmax=1,
    center=0
)
plt.title("Correlation Heatmap")
plt.show()
