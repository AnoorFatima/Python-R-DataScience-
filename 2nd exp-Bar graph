# Bargraph
import matplotlib.pyplot as plt
x=["A","B","C","D"]
y=[30,20,10,50]
plt.bar(x,y)
plt.xlabel("X-axis")
plt.ylabel("Y-axis")
plt.title("Bar Graph")
plt.show()

# Histogram
import matplotlib.pyplot as plt
x=[10,2,30,50,68,11,21,99,1,41,77,82,65,66]
y=9
plt.hist(x,y)
plt.xlabel("X-axis")
plt.ylabel("Y-axis")
plt.title("Histogram")
plt.show()
